{
  "name": "pisa-progress-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && concurrently -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "vite",
    "seed": "node scripts/check-node.mjs && node scripts/build-server.mjs && node dist-server/seed/run.js",
    "reset": "npm run seed",
    "build:server": "node scripts/build-server.mjs",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build && node scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node scripts/build-server.mjs && node dist-server/tests/run.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "multer": "1.4.5-lts.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.20",
    "esbuild": "0.25.10"
  }
}
