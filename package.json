{
  "name": "pisa-progress-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && npm run build:server && concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node dist-server/server/src/index.js",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.build.json",
    "seed": "node scripts/check-node.mjs && npm run build:server && node dist-server/server/src/seed/run.js",
    "reset": "npm run seed",
    "thu-goi": "node scripts/thu-goi-function.mjs",
    "thu-turso": "npm run build:server && node dist-server/server/src/ops/thuTurso.js",
    "build": "tsc -p tsconfig.web.json --noEmit && npm run build:server && vite build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build:server && node dist-server/server/src/tests/run.js",
    "check": "npm run build:server && npm test && npm run typecheck",
    "preview": "vite preview",
    "migrate": "node scripts/check-node.mjs && npm run build:server && node dist-server/server/src/migrate/run.js"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.0",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "libsql": "0.5.29",
    "multer": "1.4.5-lts.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "serverless-http": "4.0.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "esbuild": "0.28.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "5.4.20"
  }
}
